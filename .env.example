# ==========================================================================
# GARÇA DE BOTAS CODE STUDIO — variáveis de ambiente
# --------------------------------------------------------------------------
# S03: este arquivo (.env) está no .gitignore E no .vercelignore.
#      NUNCA faça commit dele com valores reais.
# S01: nenhuma destas variáveis chega ao navegador. Todas são lidas apenas
#      dentro de api/** (Serverless Functions). O token fica no servidor.
# S02: os e-mails dos integrantes nunca são exibidos na interface — são
#      usados somente como autor/committer no GitHub.
#
# S05: um token que foi colado em chat, issue, print ou repositório está
#      COMPROMETIDO. Revogue em
#      https://github.com/settings/tokens  e gere outro.
# ==========================================================================

# Porta do servidor de desenvolvimento local (tools/dev-server.mjs).
# Na Vercel a porta é definida pela plataforma — este valor só vale em dev.
PORT=4173

# --------------------------------------------------------------------------
# GitHub
# --------------------------------------------------------------------------
# Fine-grained token com permissão "Contents: Read and write" APENAS no
# repositório do projeto. Permissões mínimas — nada de escopo repo total.
# O valor começa com o prefixo do GitHub; não escrevemos esse prefixo aqui
# para que nenhum verificador de segredo confunda o exemplo com token real.
GITHUB_TOKEN=<cole-aqui-seu-fine-grained-token>

# Formato: organizacao-ou-usuario/nome-do-repositorio
GITHUB_REPOSITORY=organizacao-ou-usuario/nome-do-repositorio

# Branch que recebe os commits (Parte 19.1)
GITHUB_BRANCH=main

# --------------------------------------------------------------------------
# Integrantes — EXATAMENTE 4, nesta ordem (B19)
# 1 João Vitor · 2 José · 3 Rafael · 4 Fernanda
# --------------------------------------------------------------------------
CONTRIBUTOR_1_NAME=João Vitor
CONTRIBUTOR_1_USERNAME=vitorino2011
CONTRIBUTOR_1_EMAIL=joaovitorramosvitorino2011.10@gmail.com

# P03 (Anexo C): confirmar o username do GitHub de cada integrante.
# Sem username preenchido, a interface mostra as iniciais em disco colorido
# em vez da foto real — nunca um avatar genérico de estoque (19.5).
CONTRIBUTOR_2_NAME=José
CONTRIBUTOR_2_USERNAME=
CONTRIBUTOR_2_EMAIL=

CONTRIBUTOR_3_NAME=Rafael
CONTRIBUTOR_3_USERNAME=
CONTRIBUTOR_3_EMAIL=

CONTRIBUTOR_4_NAME=Fernanda
CONTRIBUTOR_4_USERNAME=
CONTRIBUTOR_4_EMAIL=
